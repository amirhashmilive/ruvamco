# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
eggs/
.eggs/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
venv/
.venv/
ENV/
env/
.python-version
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log
.mypy_cache/
.ruff_cache/

# ── Go ──────────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out
go.work
vendor/

# ── Rust ────────────────────────────────────────────────────────
target/
Cargo.lock
*.rs.bk

# ── Terraform ───────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.lock.hcl

# ── Packer ──────────────────────────────────────────────────────
packer_cache/
*.box

# ── Docker ──────────────────────────────────────────────────────
data/
docker-compose.override.yml

# ── IDE / Editor ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS ──────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Secrets / Local Config ─────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
secrets.yaml
secrets.yml

