# ────────────────────────────────────────────────────────────────
# RUVAMCO — Environment Variables (example)
# Copy to .env and fill in real values before running.
# ────────────────────────────────────────────────────────────────

# ── General ─────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SERVICE_VERSION=1.0.0

# ── AWS / Cloud ─────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# ── DynamoDB ────────────────────────────────────────────────────
DYNAMODB_TABLE=ruvamco-instances
DYNAMODB_ENDPOINT=http://localhost:8000

# ── SQS / ElasticMQ ────────────────────────────────────────────
SQS_QUEUE_URL=http://localhost:9324/queue/ruvamco-tasks
SQS_ENDPOINT=http://localhost:9324

# ── S3 / MinIO ─────────────────────────────────────────────────
S3_BUCKET_CONTEXT=ruvamco-context
S3_BUCKET_TEMPLATES=ruvamco-templates
S3_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Control Plane ───────────────────────────────────────────────
CONTROL_PLANE_URL=http://localhost:8081
XDS_PORT=18000
CACHE_TTL_SECONDS=5

# ── Broker API ──────────────────────────────────────────────────
BROKER_PORT=8080
API_KEY=dev-api-key-change-me

# ── Observability ───────────────────────────────────────────────
PROMETHEUS_ENDPOINT=http://localhost:9090
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── JWT / Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
