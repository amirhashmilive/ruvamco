{
  "dashboard": {
    "id": null,
    "uid": "ruvamco-overview",
    "title": "RUVAMCO — Platform Overview",
    "tags": ["ruvamco", "production"],
    "timezone": "utc",
    "refresh": "10s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "Active Instances",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [
          { "expr": "ruvamco_active_instances", "legendFormat": "Instances" }
        ],
        "fieldConfig": {
          "defaults": { "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1000 },
            { "color": "red", "value": 5000 }
          ]}}
        }
      },
      {
        "id": 2,
        "title": "Request Rate (RPS)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "targets": [
          { "expr": "sum(rate(ruvamco_proxy_requests_total[5m]))", "legendFormat": "Total RPS" },
          { "expr": "sum(rate(ruvamco_proxy_requests_total{status_code=~'2..'}[5m]))", "legendFormat": "2xx" },
          { "expr": "sum(rate(ruvamco_proxy_requests_total{status_code=~'5..'}[5m]))", "legendFormat": "5xx" }
        ]
      },
      {
        "id": 3,
        "title": "Request Latency (p50 / p95 / p99)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "targets": [
          { "expr": "histogram_quantile(0.50, sum(rate(ruvamco_proxy_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
          { "expr": "histogram_quantile(0.95, sum(rate(ruvamco_proxy_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
          { "expr": "histogram_quantile(0.99, sum(rate(ruvamco_proxy_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
        ]
      },
      {
        "id": 4,
        "title": "Provisioning Queue Depth",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "targets": [
          { "expr": "aws_sqs_approximate_number_of_messages_visible", "legendFormat": "Pending Tasks" }
        ]
      },
      {
        "id": 5,
        "title": "Proxy Fleet Size",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
        "targets": [
          { "expr": "count(up{job='envoy'})", "legendFormat": "Proxies" }
        ]
      },
      {
        "id": 6,
        "title": "Active Connections",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "targets": [
          { "expr": "sum(ruvamco_proxy_active_connections)", "legendFormat": "Active" }
        ]
      },
      {
        "id": 7,
        "title": "Config Propagation Latency",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
        "targets": [
          { "expr": "ruvamco_config_propagation_seconds", "legendFormat": "Propagation" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "s", "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 3 },
            { "color": "red", "value": 5 }
          ]}}
        }
      },
      {
        "id": 8,
        "title": "Error Rate (%)",
        "type": "gauge",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
        "targets": [
          { "expr": "sum(rate(ruvamco_proxy_requests_total{status_code=~'5..'}[5m])) / sum(rate(ruvamco_proxy_requests_total[5m])) * 100", "legendFormat": "Error %" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "percent", "max": 5, "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "red", "value": 1 }
          ]}}
        }
      }
    ]
  }
}
