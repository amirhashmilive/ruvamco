# Envoy Cluster — generated by RUVAMCO Control Plane
name: "cluster_{{ instance_id }}"
type: STRICT_DNS
connect_timeout: {{ (timeouts.connection if timeouts else 5) }}s
lb_policy: ROUND_ROBIN
{% if backend.protocol == 'HTTP2' or backend.protocol == 'GRPC' %}
typed_extension_protocol_options:
  envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
    "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
    explicit_http_config:
      http2_protocol_options: {}
{% endif %}
load_assignment:
  cluster_name: "cluster_{{ instance_id }}"
  endpoints:
    - lb_endpoints:
        - endpoint:
            address:
              socket_address:
                address: "{{ backend.target }}"
                port_value: {{ backend.port | default(8080) }}
health_checks:
  - timeout: 5s
    interval: 10s
    unhealthy_threshold: 3
    healthy_threshold: 2
    http_health_check:
      path: "{{ backend.health_check_path | default('/health') }}"
{% if circuit_breaker %}
circuit_breakers:
  thresholds:
    - priority: DEFAULT
      max_connections: {{ circuit_breaker.max_connections | default(1024) }}
      max_pending_requests: {{ circuit_breaker.max_pending_requests | default(1024) }}
      max_requests: {{ circuit_breaker.max_requests | default(1024) }}
      max_retries: {{ circuit_breaker.max_retries | default(3) }}
{% endif %}
outlier_detection:
  consecutive_5xx: 5
  interval: 10s
  base_ejection_time: 30s
  max_ejection_percent: 50
