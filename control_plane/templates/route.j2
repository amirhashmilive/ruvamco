# Envoy Route — generated by RUVAMCO Control Plane
name: "route_{{ instance_id }}"
virtual_hosts:
  - name: "{{ domain }}"
    domains:
      - "{{ domain }}"
      - "{{ domain }}:*"
    {% if rate_limit and rate_limit.requests_per_second %}
    rate_limits:
      - actions:
          - remote_address: {}
        stage: 0
    {% endif %}
    {% if cors %}
    cors:
      allow_origin_string_match:
        {% for origin in cors.allow_origins %}
        - exact: "{{ origin }}"
        {% endfor %}
      allow_methods: "{{ cors.allow_methods | join(',') }}"
      allow_headers: "{{ cors.allow_headers | join(',') }}"
      max_age: "{{ cors.max_age | default(86400) }}"
    {% endif %}
    routes:
      - match:
          prefix: "/"
        route:
          cluster: "cluster_{{ instance_id }}"
          {% if timeouts %}
          timeout: {{ timeouts.request | default(30) }}s
          {% endif %}
          {% if retries %}
          retry_policy:
            retry_on: "{{ retries.retry_on | default('5xx,reset,connect-failure') }}"
            num_retries: {{ retries.attempts | default(3) }}
            per_try_timeout: {{ retries.per_try_timeout | default(10) }}s
          {% endif %}
          {% if custom_headers %}
          request_headers_to_add:
            {% for key, value in custom_headers.items() %}
            - header:
                key: "{{ key }}"
                value: "{{ value }}"
              append: false
            {% endfor %}
          {% endif %}
        metadata:
          filter_metadata:
            envoy.filters.http.lua:
              instance_id: "{{ instance_id }}"
              plan: "{{ plan | default('developer') }}"
