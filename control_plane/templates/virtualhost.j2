# Envoy VirtualHost — generated by RUVAMCO Control Plane
name: "vhost_{{ instance_id }}"
domains:
  - "{{ domain }}"
  - "{{ domain }}:*"
  {% if domain.startswith('www.') %}
  - "{{ domain[4:] }}"
  {% else %}
  - "www.{{ domain }}"
  {% endif %}
{% if rate_limit and rate_limit.requests_per_second %}
rate_limits:
  - actions:
      - remote_address: {}
    stage: 0
{% endif %}
{% if cors %}
typed_per_filter_config:
  envoy.filters.http.cors:
    "@type": type.googleapis.com/envoy.extensions.filters.http.cors.v3.CorsPolicy
    allow_origin_string_match:
      {% for origin in cors.allow_origins %}
      - exact: "{{ origin }}"
      {% endfor %}
    allow_methods: "{{ cors.allow_methods | join(',') }}"
    allow_headers: "{{ cors.allow_headers | join(',') }}"
    max_age: "{{ cors.max_age | default(86400) }}"
{% endif %}
routes:
  - match:
      prefix: "/"
    route:
      cluster: "cluster_{{ instance_id }}"
      {% if timeouts %}
      timeout: {{ timeouts.request | default(30) }}s
      idle_timeout: {{ timeouts.idle | default(300) }}s
      {% endif %}
      hash_policy:
        - connection_properties:
            source_ip: true
    decorator:
      operation: "{{ domain }}/*"
